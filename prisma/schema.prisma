// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id     Int    @id @default(autoincrement())
  status Int
  OrderDetails OrderDetails[]
  OrderStatusHistory OrderStatusHistory[]
}

model Seller {
  id            Int            @id @default(autoincrement())
  customId      String   @unique 
  businessName  String
  businessOwner String
  phone         String         @unique
  gstNumber     String
  shopMarka     String?
  transport     String?
  pincode       String
  city          String
  state         String
  filePath      String?
  dropped       Boolean?       @default(false)
  qrCode        String?        @unique
  qrCodeSelf        String?        @unique
  adminId       Int?
  Admin         Admin?         @relation(fields: [adminId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  retailers     Retailer[]
  Product       Product[]
  OrderDetails  OrderDetails[]
  Notes         Notes[]
  BannerImages  BannerImages[]
  Guest Guest[]
  notificationId Int?
  notification   Notification? @relation(fields: [notificationId], references: [id])
}

model Retailer {
  id            Int            @id @default(autoincrement())
  customId      String   @unique    
  businessName  String
  businessOwner String
  phone         String         @unique
  gstNumber     String
  shopMarka     String?
  transport     String?
  pincode       String
  city          String
  state         String
  filePath      String?
  dropped       Boolean?       @default(false)
  qrCode        String?        @unique
  sellerId      String?
  seller        Seller?         @relation(fields: [sellerId], references: [customId])
  adminId       Int?
  Admin         Admin?         @relation(fields: [adminId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  OrderDetails  OrderDetails[]
  notificationId Int?
  notification   Notification? @relation(fields: [notificationId], references: [id])


  Notes Notes[]
}

model Guest {
 id           Int      @id @default(autoincrement())
 phone         String         @unique
 customId      String   @unique    
 sellerId      String?
 seller        Seller?         @relation(fields: [sellerId], references: [customId])
 createdAt     DateTime       @default(now())

}
model Notification {
  id          Int       @id @default(autoincrement())
  message     String    // Renamed from "notifications" to avoid confusion
  createdAt   DateTime  @default(now())
  retailers   Retailer[] 
  sellers     Seller[] 
   recipients String[] 
}

model Recipient {
  id              Int            @id @default(autoincrement())
  notificationId  Int
  notification    Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient       String
}

model Product {
  id           Int      @id @default(autoincrement())
  productId   String   @unique
  productName  String
  averagePrice String?
  goodPrice    String?
  highPrice    String?
  description  String?
  productImage String?
  productVideo String?
  tax          String?
  moq          String?
  sellerId     String
  seller       Seller   @relation(fields: [sellerId], references: [customId])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  OrderProductDetails OrderProductDetails[]
}

model OrderDetails {
  id                  Int                   @id @default(autoincrement())
  orderId             String                @unique
  sellerId            String
  seller              Seller                @relation(fields: [sellerId], references: [customId])
  retailerId          String
  retailer            Retailer              @relation(fields: [retailerId], references: [customId])
  statusId            Int
  status              Status                @relation(fields: [statusId], references: [id])
  totalItem           Int
  totalQuantity       Int
  notes               String
  filePath            String?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  OrderProductDetails OrderProductDetails[]
  OrderStatusHistory  OrderStatusHistory[]

  ReviewAndRating ReviewAndRating[]
  isCart        Boolean         @default(false)

}

model OrderProductDetails {
  id        Int          @id @default(autoincrement())
  orderId   String
  order     OrderDetails @relation(fields: [orderId], references: [orderId])
  productId   String
  product   Product      @relation(fields: [productId], references: [productId])
  quantity  Int
  price     Int

  
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model OrderStatusHistory {
  id        Int          @id @default(autoincrement())
  orderId   String
  order     OrderDetails @relation(fields: [orderId], references: [orderId])
  statusId  Int
  status    Status       @relation(fields: [statusId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ReviewAndRating {
  id          Int          @id @default(autoincrement())
  orderId     String
  order       OrderDetails @relation(fields: [orderId], references: [orderId])
  review      String
  ratingStars Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Notes {
  id         Int       @id @default(autoincrement())
  sellerId    String?
  seller     Seller?   @relation(fields: [sellerId], references: [customId])
  retailerId String?
  retailer   Retailer? @relation(fields: [retailerId], references: [customId])
  notes      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Admin {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String     @unique
  pincode   String?
  city      String?
  state     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Retailer  Retailer[]
  Seller    Seller[]
}

model BannerImages {
  id        Int      @id @default(autoincrement())
  imageLink String
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [customId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}
